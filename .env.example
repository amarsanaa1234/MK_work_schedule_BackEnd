# Copy to .env on the server and fill in real values.
# DOMAIN: your domain (DNS A record -> server IP), or for a quick start without
# buying a domain use <server-ip-with-dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
DOMAIN=203-0-113-10.sslip.io
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=demo_schedule
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-32-bytes-minimum-random-secret
# Optional - leave empty to run with payments disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
